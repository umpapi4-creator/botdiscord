# Discord Developer Portal > General Information > Application ID
DISCORD_APPLICATION_ID=

# Discord Developer Portal > General Information > Public Key
DISCORD_PUBLIC_KEY=

# Discord Developer Portal > Bot > Reset Token
DISCORD_BOT_TOKEN=

# Opsional: ID server untuk registrasi command instan selama development
DISCORD_GUILD_ID=

# Channel tujuan untuk command /kirim
CHANNEL_ID=

# Isi pesan yang dikirim otomatis
AUTO_MESSAGE=Halo! Ini pesan otomatis dari bot.

# Buat string acak panjang dan gunakan nilai yang sama di Vercel dan GitHub
CRON_SECRET=
